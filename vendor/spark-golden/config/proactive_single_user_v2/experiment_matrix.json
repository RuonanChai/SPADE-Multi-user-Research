{
  "name": "proactive_single_user_v2",
  "scenario": "single_user_trace",
  "warmup_ms": 20000,
  "move_ms": 40000,
  "timeout_ms": 1200000,
  "prefetch_budget_bytes": 134217728,
  "parse_budget_chunks_per_sec": 24,
  "default_prediction_horizon_ms": 2000,
  "ready_event_policy": "parse_or_upload",
  "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
  "deliveries": {
    "origin_server": {
      "profile_id": "origin_server",
      "asset_url": "http://10.120.17.176:8090/examples/streaming-lod/coit-40m-sh1-lod.rad"
    },
    "remote_server": {
      "profile_id": "remote_server",
      "use_profile": "cdn1_r2"
    },
    "local_disk": {
      "profile_id": "local_disk",
      "note": "fallback when HPC origin is offline; serves the same .rad file from disk via MonitoredAssetServer"
    }
  },
  "phases": {
    "phase0_canary": {
      "delivery": "origin_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 1
    },
    "phase0_canary_remote": {
      "delivery": "remote_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 1
    },
    "phase1_origin": {
      "delivery": "origin_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 3
    },
    "phase1_origin_interleave": {
      "delivery": "origin_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 3,
      "interleave": true
    },
    "phase1_remote_interleave": {
      "delivery": "remote_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 3,
      "interleave": true
    },
    "phase1_local_interleave": {
      "delivery": "local_disk",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 3,
      "interleave": true
    },
    "phase2_remote": {
      "delivery": "remote_server",
      "baselines": ["B0_on_demand", "B3_ready", "B4_ready_oracle"],
      "trials_per_baseline": 3
    }
  }
}
