{
  "name": "@sparkjsdev/spark",
  "version": "2.0.0",
  "description": "An advanced 3D Gaussian Splatting renderer for THREE.js",
  "homepage": "https://sparkjs.dev/",
  "type": "module",
  "main": "./dist/spark.cjs.js",
  "module": "./dist/spark.module.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/spark.module.js",
      "require": "./dist/spark.cjs.js"
    }
  },
  "scripts": {
    "assets:clean": "node scripts/clean-assets.js",
    "assets:compress": "node scripts/compress-to-spz.js",
    "assets:download": "node scripts/download-assets.js",
    "build": "npm run build:production && npm run build:dev",
    "build:dev": "vite build --mode dev",
    "build:production": "vite build --mode production",
    "build:wasm": "node rust/build_wasm.js",
    "bench:10clients": "node bench-10clients.js",
    "bench:remote:ingest": "node bench-run-remote-ingest.js",
    "trace:workload:generate": "node scripts/generate-workload-traces.mjs",
    "artifacts:export": "node scripts/export-run-artifacts.mjs",
    "bench:p3:matrix": "node scripts/run-p3-measurement-matrix.mjs",
    "proxy:instrumented": "node proxy/instrumented-reverse-proxy.mjs",
    "bench:replay:run": "node scripts/run-replay-experiment.mjs",
    "bench:abc:distributed": "node scripts/run-abc-distributed.mjs",
    "bench:bcd:repeat": "node scripts/run-bcd-repeatability.mjs",
    "setup:ssh:worker2": "powershell -ExecutionPolicy Bypass -File scripts/setup-ssh-key-worker2.ps1",
    "fix:ssh:acl:win": "powershell -ExecutionPolicy Bypass -File scripts/fix-openssh-authorized-keys-acl.ps1",
    "bench:260424v2": "node scripts/run-260424-v2-dual.mjs",
    "automation:260424v2": "node scripts/run-260424-v2-dual.mjs",
    "oneclick:260424v2": "node scripts/run-260424-v2-dual.mjs",
    "bench:replay:worker": "node scripts/replay-worker.mjs",
    "analysis:logical-pages": "node analysis/analyze-logical-pages.mjs",
    "analysis:abc:distributed": "node analysis/analyze-abc-distributed.mjs",
    "analysis:e2e:breakdown": "node analysis/analyze-e2e-latency-breakdown.mjs",
    "analysis:burst-queue": "node analysis/analyze-burst-queue-diagnosis.mjs",
    "analysis:compare-bcd": "node analysis/compare-bcd-timing-shape.mjs",
    "analysis:burst-report": "node analysis/generate-burst-queue-report.mjs",
    "analysis:bcd:repeatability": "node analysis/summarize-bcd-repeatability.mjs",
    "analysis:service-vs-bytes": "node analysis/analyze-service-vs-bytes.mjs",
    "analysis:paper-results": "node analysis/generate-paper-results-draft.mjs",
    "verify:r2-cdn": "node scripts/verify-r2-cdn-headers.mjs",
    "bench:260425:two-worker": "node scripts/run-260425-two-worker-suite.mjs",
    "bench:260425:repeat10": "node scripts/run-260425-repeat10-suite.mjs",
    "bench:260428:e2e": "node scripts/run-260428-e2e-latency-suite.mjs",
    "bench:260428:repeat10": "node scripts/run-260428-repeat10-suite.mjs",
    "bench:260428:direct": "node scripts/run-260428-direct-v1-suite.mjs",
    "bench:direct:auto": "node scripts/run-direct-measure-automation.mjs",
    "bench:260428:proxy-vs-direct": "node scripts/run-260428-proxy-direct-full-suite.mjs",
    "bench:260429_v2": "node scripts/run-260429_v2-distributed-automation.mjs",
    "validate-cdn": "node scripts/validate-cdn.mjs",
    "generate-scenarios": "node scripts/generate-scenarios.mjs",
    "experiment": "node scripts/run-pose-cdn-experiment.mjs",
    "analyze": "node scripts/analyze-pose-cdn.mjs",
    "analysis:bcd:paper": "python scripts/analyze_bcd_repeatability_paper.py",
    "analysis:report": "node analysis/generate-analysis-report.mjs",
    "build:watch": "onchange 'src/**/*.{ts,glsl}' -- npm run build:dev",
    "build-lod": "cargo run --manifest-path rust/build-lod/Cargo.toml --release --",
    "clean": "rm -rf dist/ && rm -rf node_modules/ && rm -rf rust/target/ && rm -rf rust/spark-worker-rs/pkg/ && rm -rf rust/spark-rs/pkg/ && npm run assets:clean",
    "dev": "npm run build:dev && (vite --host & npm run build:watch)",
    "dev:streaming-lod": "node scripts/dev-streaming-lod.mjs",
    "serve:rad-dev": "node scripts/serve-rad-dev.mjs",
    "docs": "node scripts/clean-site-files.js && node scripts/copy-site-files.js && mkdocs serve",
    "format": "biome format .",
    "format:fix": "biome format . --fix",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "lint:summary": "biome check --reporter=summary",
    "prepare": "",
    "site:build:relativeurls": "npm run build && npm run site:clean && node scripts/copy-site-files.js && mkdocs build && node scripts/rename-assets-to-static.js && node scripts/replace-urls.js",
    "site:build": "npm run build && npm run site:clean && node scripts/copy-site-files.js && mkdocs build && node scripts/rename-assets-to-static.js",
    "site:clean": "node scripts/clean-site-files.js && node scripts/clean-site.js",
    "site:deploy": "npm run site:build && node scripts/deploy-site.js",
    "site:serve": "node scripts/serve-site.js site",
    "start": "npm run dev",
    "test": "node --no-warnings --loader ts-node/esm --test test/**/*.test.ts",
    "vrc:paper:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_paper_experiment.ps1 check",
    "vrc:paper:orchestrator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_paper_experiment.ps1 orchestrator-detached",
    "vrc:paper:orchestrator:72": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_paper_experiment.ps1 orchestrator-detached -RunFullPipeline",
    "vrc:paper:autopilot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_paper_experiment.ps1 autopilot",
    "vrc:paper:autopilot:72": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_paper_experiment.ps1 autopilot -RunFullPipeline",
    "vrc:paper:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vrc_collect_paper_artifacts.ps1",
    "ready:single:run": "node scripts/ready_single_user/run.mjs",
    "ready:single:analyze": "node scripts/ready_single_user/analyze.mjs",
    "ready:single:phaseA": "node scripts/ready_single_user/run.mjs --phase=phaseA_sanity",
    "ready:single:phaseBmini": "node scripts/ready_single_user/run.mjs --phase=phaseB_mini",
    "ready:single:phaseB": "node scripts/ready_single_user/run.mjs --phase=phaseB_main",
    "ready:single:deliveryCompare": "node scripts/ready_single_user/run.mjs --phase=phase_delivery_compare --trials=1",
    "ready:single:localCeiling": "node scripts/ready_single_user/run.mjs --phase=phase_local_ceiling --trials=1",
    "ready:single:edgeCold": "node scripts/ready_single_user/run.mjs --phase=phase_edge_cold --trials=1",
    "ready:single:edgeWarm": "node scripts/ready_single_user/run.mjs --phase=phase_edge_warm_ready --trials=1",
    "ready:single:ablationEdge": "node scripts/ready_single_user/run.mjs --phase=phase_ready_ablation_on_edge --trials=1",
    "ready:single:remoteDirect": "node scripts/ready_single_user/run.mjs --phase=phase_remote_direct_cold --trials=1",
    "ready:single:buildOracleRef": "node scripts/ready_single_user/build_oracle_reference.mjs --phase=phase_remote_dev --delivery=remote",
    "ready:single:preflight": "node scripts/ready_single_user/preflight.mjs",
    "ready:single:miniLoop": "node scripts/ready_single_user/mini_loop.mjs",
    "ready:single:recover": "node scripts/ready_single_user/recover.mjs",
    "ready:single:cleanupPorts": "node scripts/ready_single_user/port_cleanup.mjs",
    "ready:single:autonomous": "node scripts/ready_single_user/run.mjs --autonomous"
  },
  "repository": "sparkjs-dev/spark",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/three": "0.180.0",
    "fflate": "^0.8.2",
    "lefthook": "1.11.12",
    "lil-gui": "^0.20.0",
    "onchange": "7.1.0",
    "spark-rs": "file:rust/spark-rs/pkg",
    "spark-worker-rs": "file:rust/spark-worker-rs/pkg",
    "ssh2": "^1.17.0",
    "stats.js": "^0.17.0",
    "three": "^0.180.0",
    "ts-node": "10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "^1.3.1"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "playwright": "^1.59.1"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "keywords": [
    "3d",
    "three.js",
    "gsplats",
    "3dgs",
    "gaussian",
    "splats"
  ]
}
