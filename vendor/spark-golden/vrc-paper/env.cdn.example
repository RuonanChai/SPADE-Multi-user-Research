# VRC .rad pipeline (default: Cloudflare R2 public URL + flat keys under streaming-lod/)
# Example object: https://pub-0429777a95db48e192b4c665413f8eb2.r2.dev/streaming-lod/coit-40m-sh1-lod.rad
#
# Browser (vrc_scene.html): defaults to R2 pub + streaming-lod/coit-40m-sh1-lod.rad unless ?use_gcs_rad=1
#
# Runner: probes CDN (Coit) in order: VRC_RAD_KEY_COIT, flat path, legacy path; on success passes rad_* query params.
#         If probe fails, appends use_gcs_rad=1 for that trial (Google .rad).
#
# Force Google .rad only for entire process:
# VRC_USE_GCS_ONLY=1
#
# Override R2 origin:
# VRC_RAD_ASSET_BASE=https://pub-0429777a95db48e192b4c665413f8eb2.r2.dev
#
# Override object keys (relative to base):
# VRC_RAD_KEY_COIT=streaming-lod/coit-40m-sh1-lod.rad
# VRC_RAD_KEY_HOBBITON=streaming-lod/tijerin_w6_hobbiton-lod.rad
#
# Vite (manual open vrc_scene without runner):
# VITE_VRC_RAD_ASSET_BASE=https://pub-0429777a95db48e192b4c665413f8eb2.r2.dev
# VITE_VRC_RAD_KEY_COIT=streaming-lod/coit-40m-sh1-lod.rad
#
# R2 CORS: allow http://localhost:9200 and http://127.0.0.1:9200, GET+HEAD, Range.
#
# ── Orchestrator adaptive (run_autonomous_pipeline_detached.ps1) ──
# Default: visual canaries / prefull / full 72-run escalate splat wait + CDP + per-user capture until PASS or cap.
# VRC_ADAPTIVE_VISUAL=0 — strategy ladder only, no timeout escalation between outer rounds.
# VRC_ADAPT_MAX_ROUNDS=6 — max escalation rounds for canaries + prefull (default 6).
# VRC_ADAPT_MAX_FULL_ROUNDS=4 — max full-matrix re-runs after validation still fails (default 4).
#
# Runner tuning (run_experiment.mjs; orchestrator may set these during ADAPT rounds):
# VRC_SCREENSHOT_DELAY_MS — post-goto splat wait before visual-ready (default 10000).
# VRC_CDP_CAPTURE_TIMEOUT_MS / VRC_VIEWPORT_CAPTURE_TIMEOUT_MS / VRC_DATAURL_CAPTURE_TIMEOUT_MS
# VRC_PER_USER_CAPTURE_MS — outer hard cap per user screenshot pipeline (default 45000).
# VRC_SEQ_FPS_WAIT_MS / VRC_LOW_FPS_PROBE_MS / VRC_GOTO_TIMEOUT_MS
