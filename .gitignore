# Raw scientific evidence and generated results
/evidence/
/logs/
/metrics/
/results/
/checkpoints/
/audits/
/control/
/research_control/

# Dependencies and generated builds
**/node_modules/
**/target/
**/dist/
**/build/
**/.cache/
**/__pycache__/
**/.venv/
**/venv/

# Secrets and credentials
**/.env
**/.env.*
**/*secret*
**/*credential*
**/*private_key*
**/id_ed25519*
**/id_rsa*
**/*.pem
**/*.p12
**/*.pfx
**/*.key

# Large raw experimental assets
**/*.rad
**/*.wasm
**/*.bin
**/*.npy
**/*.npz
**/*.zip
**/*.7z
**/*.tar
**/*.gz

# Temporary files
*.tmp
*.log
*.bak
*.partial

# Local editor files
.vscode/
.idea/

# Local ledgers and run state stay on F:
/execution_count.json
/runtime/state_*.json
/runtime/tasks/
/runtime/vite-cache/
/runtime/**/tmp/
/runtime/**/pkg/

# Generated LaTeX and local PDFs
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
/paper/**/*.pdf
/writing/**/*.pdf
# Keep paper figures and plotting scripts out of this research artifact
*.png
*.jpg
*.jpeg
*.pdf
*.gif
*.webp
draw*.py
*_draw.py
plot*.py
**/PAPER_SCREENSHOTS*/
**/figures/
